APP_NAME="Hayat Travel Solutions"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.example

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=ota_production
DB_USERNAME=ota_user
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=tls
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=mailer
MAIL_PASSWORD=change-me
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@your-domain.example"
MAIL_FROM_NAME="${APP_NAME}"

OTA_DEFAULT_AGENCY_SLUG=aurora-sky-travel
OTA_GUEST_LOOKUP_TOKEN_MINUTES=30
OTA_SUPPLIER_DEFAULT_PROVIDER=mock
OTA_SUPPLIER_TIMEOUT_SECONDS=20
OTA_PRIVATE_DOCUMENTS_DIRECTORY=app/private
OTA_PDF_TEMP_DIRECTORY=app/private/tmp/pdf
OTA_BACKUP_DISK=local
OTA_BACKUP_PATH=backups
