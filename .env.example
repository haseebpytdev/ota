APP_NAME="Asif Travels"
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://ota.haseebasif.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OTA_DEFAULT_AGENCY_SLUG=asif-travels

OTA_GUEST_LOOKUP_TOKEN_MINUTES=30
OTA_SUPPLIER_DEFAULT_PROVIDER=duffel
OTA_SUPPLIER_TIMEOUT_SECONDS=20
# Local-only: unsafe cached-pricing checkout fallback when live validation fails (never enable in staging/production)
OTA_ALLOW_PROVIDER_UNSTABLE_LOCAL=false
# Airline logos on results: local file (airlines.logo_path) first; else public CDN (2-letter IATA)
OTA_AIRLINE_LOGO_CDN_ENABLED=true
# OTA_AIRLINE_LOGO_CDN_TEMPLATE=https://images.kiwi.com/airlines/64x64/{CODE}.png
DUFFEL_API_VERSION=v2
DUFFEL_DEFAULT_BASE_URL=https://api.duffel.com
# Duffel access tokens belong in Admin → Supplier API settings (encrypted), not in this file.
FX_RATE_PROVIDER=frankfurter
FX_RATE_ENDPOINT=https://api.frankfurter.app/latest
FX_RATE_SECONDARY_ENDPOINT=https://open.er-api.com/v6/latest
FX_RATE_TIMEOUT_SECONDS=5
FX_RATE_CACHE_TTL_SECONDS=900
OTA_PRIVATE_DOCUMENTS_DIRECTORY=app/private
OTA_PDF_TEMP_DIRECTORY=app/private/tmp/pdf
OTA_BACKUP_DISK=local
OTA_BACKUP_PATH=backups
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI="${APP_URL}/auth/google/callback"
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI="${APP_URL}/auth/facebook/callback"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
